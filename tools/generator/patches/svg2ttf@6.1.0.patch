+// iconifyx patch (svg2ttf@6.1.0): the upstream xMin/yMin accessors initialise
+// their accumulators to 0 instead of +Infinity, so any glyph whose minimum X
+// or Y coordinate is strictly positive (very common for Iconify icons, which
+// pack content inside padding inside the 1000-em quad) silently reports a
+// header bbox of (0, 0) rather than the real extent. xMax / yMax have the
+// dual flaw — initialiser of 0 means a glyph that lives entirely in negative
+// coordinate space reports 0 instead of its real maximum. We fix all four
+// with proper ±Infinity sentinels. The `hasPoints` fallback path is
+// unchanged, so empty / blank glyphs still report (0,0) / advance-width.
+//
+// Upstream issue + tracking: see iconifyx tools/generator/patches/README +
+// CLAUDE.md §5. Also fixes Fontelico.ttf non-determinism observed under the
+// regen-twice determinism audit (DETERMINISM_AUDIT.md §16-A10).
 Object.defineProperty(Glyph.prototype, 'xMin', {
   get: function () {
-    var xMin = 0
+    var xMin = Infinity
     var hasPoints = false
 
