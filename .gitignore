node_modules/
*.tsbuildinfo
.DS_Store

# Bun
bun.lock

# Dart
.dart_tool/
.pub-cache/
.pub/
build/
ephemeral/
pubspec.lock

# Flutter
.flutter-plugins
.flutter-plugins-dependencies
.packages

# IDE
.vscode/
.idea/
*.iml

# Per-user local settings
.claude/settings.local.json

# Generator output that IS committed:
#  - packages/**/lib/src/sets/*.dart       (generated, committed)
#  - packages/**/assets/fonts/*.ttf        (generated, committed)
#  - packages/**/pubspec.yaml              (generated, committed)
#  - tools/generator/manifests/*.json      (state, committed)
#  - tools/generator/iconify.lock.json     (state, committed)

# Generator output that is NOT committed:
tools/generator/.cache/
# (.cache/ covers both the legacy flat-file strokefill/ tree and the
# SQLite-backed strokefill.sqlite + strokefill.sqlite-wal / -shm
# sidecars introduced in RESEARCH_PLAN.md §15 / 13.3. Listed
# explicitly here for searchability.)
tools/generator/.cache/strokefill/
tools/generator/.cache/strokefill.sqlite
tools/generator/.cache/strokefill.sqlite-*
tools/generator/tmp/
# §13 Rec 1 manifest-diff incremental snapshot cache. Per-developer;
# never committed. Bun test creates this lazily when --incremental is
# used; safe to delete at any time.
tools/generator/manifests/.cache/

# Python byte-code cache from audit subprocesses
__pycache__/
*.pyc

# Local pub-get-all log dir
.iconifyx-pub-get-*

# Local test app build artifacts
test_apps/*/build/
test_apps/*/.dart_tool/
test_apps/*/pubspec.lock

# FVM Version Cache
.fvm/