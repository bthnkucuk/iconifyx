# Per-user local settings
.claude/settings.local.json

# Generator output that IS committed:
#  - packages/**/lib/src/sets/*.dart       (generated, committed)
#  - packages/**/assets/fonts/*.ttf        (generated, committed)
#  - packages/**/pubspec.yaml              (generated, committed)
#  - tools/generator/manifests/*.json      (state, committed)
#  - tools/generator/iconify.lock.json     (state, committed)

# Generator output that is NOT committed:
tools/generator/.cache/
tools/generator/tmp/

# Local pub-get-all log dir
.iconifyx-pub-get-*

# Local test app build artifacts
test_apps/*/build/
test_apps/*/.dart_tool/
test_apps/*/pubspec.lock
